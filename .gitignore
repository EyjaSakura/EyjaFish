# Source-only monorepo: runtime data/logs/backups/secrets are never committed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/plugins/
/plugins/*
!/plugins/dsh-qq-onebot-bridge/
!/plugins/features/
!/plugins/memory-core/
!/qqbot/
/qqbot/*
!/qqbot/scripts/
!/qqbot/start-stack.ps1
!/qqbot/stop-stack.ps1
!/qqbot/docs/
!/qqbot/README.md
!/qqbot/PORTS.md
!/qqbot/data/
/qqbot/data/*
!/qqbot/data/*.example.json
!/ports.json
!/PORTS.md

# Inside included trees
**/node_modules/
**/*.log
**/*.bak*
**/*.tmp
**/.DS_Store
/plugins/features/status.json
/plugins/features/disabled.json
/qqbot/scripts/*.bak*
